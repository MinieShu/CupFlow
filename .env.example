# 仅在服务端设置；不要将真实 Key 写进前端或提交到仓库。
# 国内视觉识别可填写兼容 OpenAI Chat Completions 的服务，例如阿里云百炼。
VISION_API_BASE_URL=https://your-provider.example/compatible-mode/v1
VISION_API_KEY=your_server_side_key
VISION_MODEL=your_vision_model_name
# 可选：按所选模型官方价目填写，用于本地调用成本估算；不填写则仅记录 token 用量。
VISION_INPUT_COST_CNY_PER_1K_TOKENS=
VISION_OUTPUT_COST_CNY_PER_1K_TOKENS=
